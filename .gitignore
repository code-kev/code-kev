!/assets/profile/*.svg
!/package.json
!/package-lock.json
!/scripts/
/scripts/*
!/scripts/check-profile.mjs
!/scripts/check-profile.test.mjs
!/scripts/render-profile.mjs
!/scripts/render-profile.test.mjs
!/scripts/glyph-example.test.mjs
!/scripts/render-night.mjs
!/scripts/render-night.test.mjs
!/profile/
/profile/*
!/profile/content.json
!/profile/glyphs.json
!/docs/
/docs/*
!/docs/README.md
!/docs/profile.md
!/docs/artwork.md
!/docs/maintenance.md
!/docs/automation.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/artwork.yml
!/.github/dependabot.yml
!/skills/
/skills/*
!/skills/glyph-artwork/
/skills/glyph-artwork/*
