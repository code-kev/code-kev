# Publish finished assets and the files needed to maintain and verify them.
*
!/.gitignore
!/README.md
!/assets/
/assets/*
!/assets/day.gif
!/assets/night.gif
!/assets/day.png
!/assets/night.png
!/assets/profile/
/assets/profile/*
!/assets/profile/*.svg
!/package.json
!/package-lock.json
!/scripts/
/scripts/*
!/scripts/check-profile.mjs
!/scripts/check-profile.test.mjs
!/docs/
/docs/*
!/docs/README.md
!/docs/maintenance.md
!/docs/automation.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/artwork.yml
