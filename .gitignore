# Publish finished assets and the files needed to maintain and verify them.
*
!/.gitignore
!/README.md
!/assets/
/assets/*
!/assets/day.gif
!/assets/night.gif
!/assets/day.webp
!/assets/night.webp
!/assets/day.png
!/assets/night.png
!/assets/profile/
/assets/profile/*
!/assets/profile/*.svg
!/package.json
!/package-lock.json
!/scripts/
/scripts/*
!/scripts/check-profile.mjs
!/scripts/check-profile.test.mjs
!/docs/
/docs/*
!/docs/README.md
!/docs/maintenance.md
!/docs/automation.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/artwork.yml
!/skills/
/skills/*
!/skills/glyph-artwork/
/skills/glyph-artwork/*
!/skills/glyph-artwork/SKILL.md
!/skills/glyph-artwork/agents/
/skills/glyph-artwork/agents/*
!/skills/glyph-artwork/agents/openai.yaml
!/skills/glyph-artwork/references/
/skills/glyph-artwork/references/*
!/skills/glyph-artwork/references/github-readme.md
!/skills/glyph-artwork/references/code-kev-profile.md
